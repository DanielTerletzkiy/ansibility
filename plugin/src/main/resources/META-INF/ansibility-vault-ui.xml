<!-- Area fragment: vault UI (V3/V3b: reveal, edit popup, card section, X16 folding, value intentions, X93 gutter; V6a/V6b: banner, decrypted tab, file actions; R21: the vault and secret monitoring). Included from plugin.xml; only the owning work units edit this file, each in its own block. -->
<idea-plugin>
    <!-- v3 -->
    <extensions defaultExtensionNs="de.terletzkiy.ansibility">
        <!-- F7.1: the timed, masked Reveal popup VaultOperations.reveal hands the plaintext to -->
        <vaultRevealPresenter implementation="de.terletzkiy.ansibility.vault.ui.VaultPopupRevealPresenter"/>
        <!-- F7.14: the card's Vault row (status only, never decrypts) -->
        <cardSection id="ansibilityVault" order="after ansibilityHostDefinition"
                     implementation="de.terletzkiy.ansibility.vault.ui.VaultCardSection"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- F7.14: the card's Reveal link -->
        <platform.backend.documentation.linkHandler implementation="de.terletzkiy.ansibility.vault.ui.VaultCardLinkHandler"/>
        <!-- X16: fold !vault | bodies (next to YAMLFoldingBuilder, spike S-V2) -->
        <lang.foldingBuilder language="yaml" implementationClass="de.terletzkiy.ansibility.vault.ui.VaultFoldingBuilder"/>
        <!-- X93: lock gutter, click = Reveal -->
        <codeInsight.lineMarkerProvider language="yaml" implementationClass="de.terletzkiy.ansibility.vault.ui.VaultLineMarkerProvider"/>
        <!-- The questions of the value actions (tests replace it) -->
        <applicationService serviceInterface="de.terletzkiy.ansibility.vault.actions.VaultActionPrompts"
                            serviceImplementation="de.terletzkiy.ansibility.vault.actions.VaultDialogPrompts"/>

        <!-- F7.1-F7.6: classic intentions (startInWriteAction = false, HTML previews without the value) -->
        <intentionAction>
            <language>yaml</language>
            <className>de.terletzkiy.ansibility.vault.actions.VaultRevealIntention</className>
            <bundleName>messages.AnsibilityVaultUiBundle</bundleName>
            <categoryKey>intention.category</categoryKey>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>yaml</language>
            <className>de.terletzkiy.ansibility.vault.actions.VaultCopyIntention</className>
            <bundleName>messages.AnsibilityVaultUiBundle</bundleName>
            <categoryKey>intention.category</categoryKey>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>yaml</language>
            <className>de.terletzkiy.ansibility.vault.actions.VaultEditIntention</className>
            <bundleName>messages.AnsibilityVaultUiBundle</bundleName>
            <categoryKey>intention.category</categoryKey>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>yaml</language>
            <className>de.terletzkiy.ansibility.vault.actions.VaultEncryptIntention</className>
            <bundleName>messages.AnsibilityVaultUiBundle</bundleName>
            <categoryKey>intention.category</categoryKey>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>yaml</language>
            <className>de.terletzkiy.ansibility.vault.actions.VaultDecryptToPlainIntention</className>
            <bundleName>messages.AnsibilityVaultUiBundle</bundleName>
            <categoryKey>intention.category</categoryKey>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>yaml</language>
            <className>de.terletzkiy.ansibility.vault.actions.VaultRekeyIntention</className>
            <bundleName>messages.AnsibilityVaultUiBundle</bundleName>
            <categoryKey>intention.category</categoryKey>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
        <intentionAction>
            <language>yaml</language>
            <className>de.terletzkiy.ansibility.vault.actions.VaultChangeIdIntention</className>
            <bundleName>messages.AnsibilityVaultUiBundle</bundleName>
            <categoryKey>intention.category</categoryKey>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
    </extensions>

    <projectListeners>
        <!-- X93: re-run the lock gutter of open vault files when a lock state changes -->
        <listener class="de.terletzkiy.ansibility.vault.ui.VaultGutterRefresher"
                  topic="de.terletzkiy.ansibility.api.VaultStatusListener"/>
    </projectListeners>
    <!-- /v3 -->
    <!-- v6a -->
    <extensions defaultExtensionNs="de.terletzkiy.ansibility">
        <!-- F7.7: the src hover of a whole-file vault; null for every other src -->
        <siteDocumentation id="ansibilityVaultTemplateRef" order="first"
                           implementation="de.terletzkiy.ansibility.vault.tab.VaultTemplateRefDocumentation"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <!-- F7.7: the whole-file vault banner; F7.8: the decrypted tab's banner -->
        <editorNotificationProvider implementation="de.terletzkiy.ansibility.vault.tab.WholeFileVaultBanner"/>
        <!-- F7.8: the save path of decrypted tabs (spike S-V1) -->
        <fileDocumentSynchronizationVetoer implementation="de.terletzkiy.ansibility.vault.tab.DecryptedVaultSaveVetoer"/>
        <editorTabColorProvider implementation="de.terletzkiy.ansibility.vault.tab.DecryptedVaultTabColor"/>
        <projectCloseHandler implementation="de.terletzkiy.ansibility.vault.tab.DecryptedTabsCloseHandler"/>
        <!-- The questions about unsaved decrypted edits (tests replace it) -->
        <applicationService serviceInterface="de.terletzkiy.ansibility.vault.tab.DecryptedTabPrompts"
                            serviceImplementation="de.terletzkiy.ansibility.vault.tab.DecryptedTabDialogPrompts"/>
    </extensions>

    <projectListeners>
        <listener class="de.terletzkiy.ansibility.vault.tab.VaultTabStatusListener"
                  topic="de.terletzkiy.ansibility.api.VaultStatusListener"/>
        <listener class="de.terletzkiy.ansibility.vault.tab.DecryptedTabsFileListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
    <!-- /v6a -->
    <!-- v6b: the file actions (F7.5, F7.6, F7.8). The whole-file vault banner links RekeyFile, ChangeFileId and
         DecryptFileInPlace by id; Find Action finds them all, as "Ansibility Vault: …" and by their R18 texts (synonyms).
         R19 (D141, D142): every Ansibility.Vault.* text starts with "Ansibility Vault"; inside the submenus and New the
         actions show short texts (VaultActionTexts). -->
    <actions resource-bundle="messages.AnsibilityVaultUiBundle">
        <action id="Ansibility.Vault.EncryptFile" class="de.terletzkiy.ansibility.vault.actions.EncryptFileAction">
            <synonym key="action.Ansibility.Vault.EncryptFile.synonym"/>
        </action>
        <action id="Ansibility.Vault.DecryptFileInPlace" class="de.terletzkiy.ansibility.vault.actions.DecryptFileInPlaceAction">
            <synonym key="action.Ansibility.Vault.DecryptFileInPlace.synonym"/>
        </action>
        <action id="Ansibility.Vault.RekeyFile" class="de.terletzkiy.ansibility.vault.actions.RekeyFileAction">
            <synonym key="action.Ansibility.Vault.RekeyFile.synonym"/>
        </action>
        <action id="Ansibility.Vault.ChangeFileId" class="de.terletzkiy.ansibility.vault.actions.ChangeFileIdAction">
            <synonym key="action.Ansibility.Vault.ChangeFileId.synonym"/>
        </action>
        <action id="Ansibility.Vault.NewFile" class="de.terletzkiy.ansibility.vault.actions.NewVaultFileAction" icon="AllIcons.Ide.Readonly">
            <synonym key="action.Ansibility.Vault.NewFile.synonym"/>
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <!-- The Project view's, the editor's and the editor tab's "Ansibility Vault" menu; Find Action lists the Tools
             one only (same name, same items) -->
        <group id="Ansibility.Vault.FileMenu" class="de.terletzkiy.ansibility.vault.actions.VaultFileActionGroup" popup="true"
               searchable="false">
            <reference ref="Ansibility.Vault.EncryptFile"/>
            <reference ref="Ansibility.Vault.DecryptFileInPlace"/>
            <separator/>
            <reference ref="Ansibility.Vault.RekeyFile"/>
            <reference ref="Ansibility.Vault.ChangeFileId"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </group>
        <!-- Tools › Ansibility Vault -->
        <group id="Ansibility.Vault.ToolsMenu" class="de.terletzkiy.ansibility.vault.actions.VaultFileActionGroup" popup="true">
            <reference ref="Ansibility.Vault.EncryptFile"/>
            <reference ref="Ansibility.Vault.DecryptFileInPlace"/>
            <separator/>
            <reference ref="Ansibility.Vault.RekeyFile"/>
            <reference ref="Ansibility.Vault.ChangeFileId"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>
    <!-- /v6b -->
    <!-- d165-d166: the monitoring of plan amendment R21: vault.monitor.SecretHealthService (a light service; started when
         a project opens) keeps a snapshot of every broken vault and plaintext key of the workspace from the indexes
         (ansibility.secrets, ansible.vault); the Ansibility tool window shows it in its Vault tab with a red badge
         (added by toolwindow.AnsibleToolWindowFactory); new findings are announced once per user (application-level
         memory, never project files). Names, kinds and counts only, never content. -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="de.terletzkiy.ansibility.vault.monitor.SecretHealthActivity"/>
        <notificationGroup id="Ansibility.Vault" displayType="STICKY_BALLOON"
                           bundle="messages.AnsibilityVaultUiBundle" key="monitor.notification.group"/>
        <notificationGroup id="Ansibility.Vault.Warnings" displayType="BALLOON"
                           bundle="messages.AnsibilityVaultUiBundle" key="monitor.notification.group.warnings"/>
        <!-- The Exclude Path question and Show in Project View of the Vault tab (tests replace it) -->
        <applicationService serviceInterface="de.terletzkiy.ansibility.vault.monitor.SecretTabPrompts"
                            serviceImplementation="de.terletzkiy.ansibility.vault.monitor.SecretTabDialogPrompts"/>
    </extensions>
    <!-- /d165-d166 -->
    <!-- F7.9: Settings › Ansibility › Vault: ids per root, IDE password store, 1Password, env → id -->
    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable parentId="de.terletzkiy.ansibility.settings"
                             instance="de.terletzkiy.ansibility.vault.ui.settings.VaultConfigurable"
                             id="de.terletzkiy.ansibility.settings.vault"
                             bundle="messages.AnsibilityVaultUiBundle"
                             key="settings.vault.name"
                             nonDefaultProject="true"/>
    </extensions>
</idea-plugin>
