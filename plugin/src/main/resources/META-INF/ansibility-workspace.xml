<!-- Area fragment: workspace scopes (plan amendment R9, A.15: WorkspaceScopeService, scope selector, cross-repo
     features). Included from plugin.xml; only the workspace-scope work units (WS1-WS9) edit this file. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- ws1 -->
        <!-- F9.1: the workspace scope (choice, both NamedScopesHolders, coverage); narrows lists, never resolution -->
        <projectService serviceInterface="de.terletzkiy.ansibility.api.WorkspaceScopeService"
                        serviceImplementation="de.terletzkiy.ansibility.workspace.WorkspaceScopeServiceImpl"/>
        <!-- the selector's dialogs and Project view hand-off, replaceable in tests -->
        <applicationService serviceInterface="de.terletzkiy.ansibility.workspace.ScopeUi"
                            serviceImplementation="de.terletzkiy.ansibility.workspace.DefaultScopeUi"/>
        <!-- /ws1 -->
        <!-- ws8: F9.9 Find choosers and Search Everywhere › Symbols -->
        <searchScopesProvider implementation="de.terletzkiy.ansibility.workspace.search.AnsibleSearchScopes"/>
        <gotoSymbolContributor implementation="de.terletzkiy.ansibility.workspace.search.AnsibleSymbolContributor"/>
        <!-- /ws8 -->
        <!-- x69: task, block, loop and Jinja live templates in YAML and templates -->
        <defaultLiveTemplates file="/liveTemplates/Ansibility.xml"/>
        <liveTemplateContext contextId="ANSIBILITY_YAML" implementation="de.terletzkiy.ansibility.workspace.AnsibleTemplateContext"/>
    </extensions>

    <extensions defaultExtensionNs="de.terletzkiy.ansibility">
        <!-- ws9: the scope segment of the context widget, after the file scope and vault segments -->
        <contextWidgetSegment id="ansibilityWorkspaceScope" order="last"
                              implementation="de.terletzkiy.ansibility.workspace.ScopeWidgetSegment"/>
    </extensions>

    <actions resource-bundle="messages.AnsibilityScopeBundle">
        <!-- ws1 -->
        <!-- F9.1 / D45: [Scope ▾] is the first item of the tool-window toolbar's extra group (R8's context button follows) -->
        <action id="Ansibility.Scope.Combo" class="de.terletzkiy.ansibility.workspace.actions.AnsibleScopeComboAction">
            <add-to-group group-id="Ansibility.ToolWindow.Toolbar.Extra" anchor="first"/>
        </action>
        <action id="Ansibility.Scope.Switch" class="de.terletzkiy.ansibility.workspace.actions.SwitchScopeAction"/>
        <action id="Ansibility.Scope.EditScopes" class="de.terletzkiy.ansibility.workspace.actions.EditScopesAction"/>
        <action id="Ansibility.Scope.OpenInProjectView"
                class="de.terletzkiy.ansibility.workspace.actions.OpenScopeInProjectViewAction"/>
        <!-- /ws1 -->
        <!-- ws7: F9.8 -->
        <action id="Ansibility.VarInAllRepos" class="de.terletzkiy.ansibility.workspace.crossroot.VarInAllReposAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="GoToMenu" anchor="last"/>
        </action>
        <!-- /ws7 -->
        <!-- ws9: the Environments tab's env rows -->
        <action id="Ansibility.UseEnvInAllRoots" class="de.terletzkiy.ansibility.workspace.actions.UseEnvInAllRootsAction">
            <add-to-group group-id="Ansibility.ToolWindow.Popup" anchor="last"/>
        </action>
        <!-- /ws9 -->
        <!-- x64 -->
        <action id="Ansibility.NewRole" class="de.terletzkiy.ansibility.workspace.actions.NewRoleAction" icon="AllIcons.Nodes.Package">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>
    <!-- x82: node context menu -->
    <actions resource-bundle="messages.AnsibilityToolWindowBundle">
        <action id="Ansibility.ToolWindow.CopyName" class="de.terletzkiy.ansibility.toolwindow.CopyNodeNameAction"
                icon="AllIcons.Actions.Copy">
            <add-to-group group-id="Ansibility.ToolWindow.Popup" anchor="last"/>
        </action>
        <action id="Ansibility.ToolWindow.ShowInProject" class="de.terletzkiy.ansibility.toolwindow.ShowNodeInProjectAction">
            <add-to-group group-id="Ansibility.ToolWindow.Popup" anchor="last"/>
        </action>
    </actions>
    <!-- R24 D177: a root row's "Use as Golden Root" (the setting is Settings › Ansibility › Role drift) -->
    <actions resource-bundle="messages.AnsibilityDriftBundle">
        <action id="Ansibility.Golden.SetGoldenRoot" class="de.terletzkiy.ansibility.toolwindow.UseAsGoldenRootAction">
            <add-to-group group-id="Ansibility.ToolWindow.Popup" anchor="after" relative-to-action="Ansibility.UseAsAnsibleContext"/>
        </action>
    </actions>
</idea-plugin>
