<!-- Loaded only when the IDE has VCS support (com.intellij.modules.vcs): the X99 vault commit check (M4.6) and the
     M10 workflow integrations register here. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- d167: the commit check (plan amendment R21; X99 of R7/R8): plaintext private keys, vault password files and
             broken or decrypted vaults stop a commit with Commit Anyway and Encrypt Files…. CommitCheck, early, dumb
             aware; public API only (no BooleanCommitOption: its switch is on the Vault settings page). -->
        <checkinHandlerFactory implementation="de.terletzkiy.ansibility.vault.vcs.impl.SecretCheckinHandlerFactory"/>
        <!-- /d167 -->
    </extensions>
    <extensions defaultExtensionNs="de.terletzkiy.ansibility">
        <!-- v108: the VCS status of files for ANS-V108 (plan amendment R21, D162): ProjectLevelVcsManager,
             ChangeListManager and FileStatusManager.addFileStatusListener (public API only). This fragment loads only
             with VCS support, so no always-loaded class touches a VCS class. -->
        <trackedStatusLookup implementation="de.terletzkiy.ansibility.vault.vcs.impl.VcsTrackedStatusLookup"/>
        <!-- /v108 -->
        <!-- d183: the last committed change of a role file or role directory (plan amendment R24): VcsHistoryProviderEx /
             VcsHistoryProvider of the file's VCS, public API only. -->
        <lastChangeLookup implementation="de.terletzkiy.ansibility.golden.vcs.impl.VcsLastChangeLookup"/>
        <!-- /d183 -->
        <!-- d188: whether a role copy has uncommitted changes, for the Push dialog's warning (plan amendment R24):
             ChangeListManager's changes and unversioned files below the directory, public API only. -->
        <localChangesLookup implementation="de.terletzkiy.ansibility.golden.vcs.impl.PushLocalChangesLookup"/>
        <!-- /d188 -->
        <!-- d184: the merge workspace of Align (plan amendment R24, D185): the platform's Conflicts dialog through
             AbstractVcsHelper.showMergeDialogWithResult with a MergeProvider2 and a MergeSessionEx (public API only). -->
        <roleMergeDialog implementation="de.terletzkiy.ansibility.golden.vcs.impl.AlignVcsMergeDialog"/>
        <!-- /d184 -->
    </extensions>
</idea-plugin>
