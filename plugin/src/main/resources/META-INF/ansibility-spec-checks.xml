<!-- Area fragment: argument spec checks (ANS-S002 role inputs the spec does not declare; ANS-S003–S005 documented defaults vs role defaults, plan amendment R23). Included from plugin.xml. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- No language: role templates have any file type; the inspection returns at once outside role files. -->
        <localInspection shortName="AnsibleRoleInputNotInSpec"
                         bundle="messages.AnsibilitySpecBundle" key="inspection.s002.display.name"
                         groupPath="Ansibility" groupBundle="messages.AnsibilitySpecBundle" groupKey="inspection.group.variables"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="de.terletzkiy.ansibility.inspections.spec.AnsibleRoleInputNotInSpecInspection"/>
        <!-- No language: role defaults may be YAML, JSON or extension-less files; the inspections return at once elsewhere. -->
        <localInspection shortName="AnsibleSpecDefaultMismatch"
                         bundle="messages.AnsibilitySpecBundle" key="inspection.s003.display.name"
                         groupPath="Ansibility" groupBundle="messages.AnsibilitySpecBundle" groupKey="inspection.group.variables"
                         enabledByDefault="true" level="ERROR"
                         implementationClass="de.terletzkiy.ansibility.inspections.spec.AnsibleSpecDefaultMismatchInspection"/>
        <localInspection shortName="AnsibleSpecDefaultNotApplied"
                         bundle="messages.AnsibilitySpecBundle" key="inspection.s004.display.name"
                         groupPath="Ansibility" groupBundle="messages.AnsibilitySpecBundle" groupKey="inspection.group.variables"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="de.terletzkiy.ansibility.inspections.spec.AnsibleSpecDefaultNotAppliedInspection"/>
        <localInspection shortName="AnsibleSpecDefaultUndocumented"
                         bundle="messages.AnsibilitySpecBundle" key="inspection.s005.display.name"
                         groupPath="Ansibility" groupBundle="messages.AnsibilitySpecBundle" groupKey="inspection.group.variables"
                         enabledByDefault="true" level="TEXT ATTRIBUTES"
                         implementationClass="de.terletzkiy.ansibility.inspections.spec.AnsibleSpecDefaultUndocumentedInspection"/>
    </extensions>
</idea-plugin>
