    },
    "pkg_mgr": {
      "type": "str",
      "description": "Detected package manager, e.g. apt."
    },
    "proc_cmdline": {
      "type": "dict",
      "description": "Kernel command line parameters (repeated names become lists)."
    },
    "processor": {
      "type": "list",
      "description": "Processor descriptions.",
      "elements": "str"
    },
    "processor_cores": {
      "type": "int",
      "description": "Cores per processor."
    },
    "processor_count": {
      "type": "int",
      "description": "Number of physical processors."
    },
    "processor_nproc": {
      "type": "int",
      "description": "Processors available to the connection user (nproc)."
    },
    "processor_threads_per_core": {
      "type": "int",
      "description": "Threads per core."
    },
    "processor_vcpus": {
      "type": "int",
      "description": "Number of virtual CPUs."
    },
    "product_name": {
      "type": "str",
      "description": "Product name from DMI."
    },
    "product_serial": {
      "type": "str",
      "description": "Product serial number from DMI."
    },
    "product_uuid": {
      "type": "str",
      "description": "Product UUID from DMI."
    },
    "product_version": {
      "type": "str",
      "description": "Product version from DMI."
    },
    "python": {
