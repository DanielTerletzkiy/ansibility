{% if log_sources is defined and log_sources | length > 0 %}
local.file_match "app_logs" {
  path_targets = [
{% for source in log_sources %}
    {__path__ = "{{ source.path }}", kind = "{{ source.kind }}"
{%- if source.kind == "web" %}, vhost = "{{ source.vhost }}"
{%- elif source.kind == "worker" %}, queue = "{{ source.queue }}"
{%- elif source.kind == "cron" %}, job = "{{ source.job }}", schedule = "{{ source.schedule | default('daily') }}"
{%- endif %}},
{% endfor %}
  ]
}

loki.source.file "app_logs" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.app_logs.receiver]
}

loki.process "app_logs" {
  stage.regex {
    expression = "^/srv/{{ site_name }}/releases/(?P<release>[^/]+)/"
  }

  forward_to = [loki.write.default.receiver]
}
{% endif %}
