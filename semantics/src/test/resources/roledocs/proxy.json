                            "mode": {
                                "choices": [
                                    "http",
                                    "tcp"
                                ],
                                "default": "http",
                                "description": "Default proxy mode.",
                                "type": "str"
                            },
                            "options": {
                                "default": [
                                    "httplog",
                                    "dontlognull"
