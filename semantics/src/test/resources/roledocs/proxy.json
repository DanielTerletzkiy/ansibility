                "description": [
                    "Renders C(/etc/lbd/lbd.cfg) from O(proxy_frontends) and O(proxy_backends)."
                ],
                "options": {
                    "proxy_acl_values": {
                        "default": [
                            1,
                            "two",
                            3.5,
                            true,
                            null
                        ],
                        "description": "Values of mixed types, passed through unchanged.",
                        "elements": "raw",
                        "type": "list"
                    },
                    "proxy_backends": {
                        "default": [],
                        "description": "Backends and their servers.",
                        "elements": "dict",
                        "options": {
                            "backup_servers": {
                                "default": [],
                                "description": "Servers used only when every active server is down.",
                                "elements": "dict",
                                "options": {
                                    "address": {
                                        "description": "Address and port, for example V(198.51.100.11:8080).",
                                        "required": true,
                                        "type": "str"
                                    },
                                    "check": {
                                        "description": "Health check of this server.",
                                        "options": {
                                            "fall": {
                                                "default": 3,
