                                                "type": "int"
                                            },
                                            "interval": {
                                                "default": "2s",
                                                "description": "Time between two checks.",
                                                "type": "str"
                                            },
                                            "rise": {
                                                "default": 2,
                                                "description": "Successful checks before the server counts as up.",
                                                "type": "int"
                                            }
                                        },
                                        "type": "dict"
                                    },
                                    "name": {
                                        "description": "Server name.",
                                        "required": true,
                                        "type": "str"
                                    },
                                    "weight": {
                                        "default": 100,
                                        "description": "Relative weight.",
                                        "type": "int"
                                    }
                                },
                                "type": "list"
                            },
                            "balance": {
                                "choices": [
                                    "roundrobin",
                                    "leastconn",
                                    "source",
                                    "uri"
                                ],
                                "default": "roundrobin",
                                "description": "Balancing algorithm.",
                                "type": "str"
                            },
                            "name": {
                                "description": "Backend name.",
                                "required": true,
                                "type": "str"
                            },
                            "servers": {
                                "default": [],
                                "description": "Active servers.",
                                "elements": "dict",
                                "options": {
                                    "address": {
                                        "description": "Address and port, for example V(198.51.100.11:8080).",
                                        "required": true,
                                        "type": "str"
                                    },
                                    "check": {
                                        "description": "Health check of this server.",
                                        "options": {
                                            "fall": {
                                                "default": 3,
                                                "description": "Failed checks before the server counts as down.",
                                                "type": "int"
                                            },
                                            "interval": {
                                                "default": "2s",
                                                "description": "Time between two checks.",
                                                "type": "str"
                                            },
                                            "rise": {
                                                "default": 2,
                                                "description": "Successful checks before the server counts as up.",
                                                "type": "int"
                                            }
                                        },
                                        "type": "dict"
                                    },
                                    "name": {
                                        "description": "Server name.",
                                        "required": true,
                                        "type": "str"
                                    },
                                    "weight": {
                                        "default": 100,
                                        "description": "Relative weight.",
                                        "type": "int"
                                    }
                                },
                                "type": "list"
                            }
                        },
                        "type": "list"
                    },
                    "proxy_defaults": {
                        "default": {},
