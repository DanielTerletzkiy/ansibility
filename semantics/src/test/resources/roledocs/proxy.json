                                "description": "HTTP major versions offered.",
                                "elements": "int",
                                "type": "list"
                            },
                            "mode": {
                                "choices": [
                                    "http",
                                    "tcp"
                                ],
                                "description": "Overrides O(proxy_defaults.mode).",
                                "type": "str"
                            },
                            "name": {
                                "description": "Frontend name.",
                                "required": true,
                                "type": "str"
                            }
                        },
                        "type": "list"
                    },
                    "proxy_global_extra": {
                        "description": "Extra lines for the C(global) section, a string or a list of strings.",
                        "type": "raw"
                    },
                    "proxy_maxconn": {
                        "default": 4096,
                        "description": "Global connection limit.",
                        "type": "int"
                    },
                    "proxy_resolvers": {
                        "description": "Must be an empty mapping; reserved for later use.",
                        "options": {},
