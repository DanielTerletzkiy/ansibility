{
  "ansible_core": "2.18.8",
  "tool": "ansible-inventory",
  "args": [
    "--list",
    "--export",
    "--playbook-dir",
    "{project}"
  ],
  "cfg": "project/ansible.cfg",
  "cwd": "cwd",
  "env": {},
  "rc": 0,
  "stdout": {
    "_meta": {
      "hostvars": {
        "web1": {
          "inline": 1
        }
      }
    },
    "all": {
      "children": [
        "ungrouped",
        "web"
      ]
    },
    "web": {
      "hosts": [
        "web1"
      ],
      "vars": {
        "group_inline": 1
      }
    }
  },
  "stderr": ""
}
