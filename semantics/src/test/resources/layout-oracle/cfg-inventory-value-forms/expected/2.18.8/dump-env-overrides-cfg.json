{
  "ansible_core": "2.18.8",
  "tool": "ansible-config",
  "args": [
    "dump",
    "--only-changed",
    "--format",
    "json"
  ],
  "cfg": "project/cfg/list.cfg",
  "cwd": "cwd",
  "env": {
    "ANSIBLE_INVENTORY": "a.ini, b.yml"
  },
  "rc": 0,
  "stdout": [
    {
      "name": "ANSIBLE_FORCE_COLOR",
      "origin": "env: ANSIBLE_FORCE_COLOR",
      "value": false
    },
    {
      "name": "ANSIBLE_NOCOLOR",
      "origin": "env: ANSIBLE_NOCOLOR",
      "value": true
    },
    {
      "name": "CONFIG_FILE",
      "origin": "",
      "value": "{project}/cfg/list.cfg"
    },
    {
      "name": "DEFAULT_HOST_LIST",
      "origin": "env: ANSIBLE_INVENTORY",
      "value": [
        "{cwd}/a.ini",
        "{cwd}/b.yml"
      ]
    },
    {
      "GALAXY_SERVERS": {}
    }
  ],
  "stderr": ""
}
