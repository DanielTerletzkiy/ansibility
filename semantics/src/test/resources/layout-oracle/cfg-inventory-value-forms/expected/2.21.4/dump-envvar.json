{
  "ansible_core": "2.21.4",
  "tool": "ansible-config",
  "args": [
    "dump",
    "--only-changed",
    "--format",
    "json"
  ],
  "cfg": "project/cfg/envvar.cfg",
  "cwd": "cwd",
  "env": {
    "INVDIR": "{project}/sub"
  },
  "rc": 0,
  "stdout": [
    {
      "name": "ANSIBLE_FORCE_COLOR",
      "origin": "env: ANSIBLE_FORCE_COLOR",
      "value": false
    },
    {
      "name": "ANSIBLE_NOCOLOR",
      "origin": "env: ANSIBLE_NOCOLOR",
      "value": true
    },
    {
      "name": "CONFIG_FILE",
      "origin": "",
      "value": "{project}/cfg/envvar.cfg"
    },
    {
      "name": "DEFAULT_HOST_LIST",
      "origin": "{project}/cfg/envvar.cfg",
      "value": [
        "{project}/sub/hosts.ini"
      ]
    },
    {
      "GALAXY_SERVERS": {}
    }
  ],
  "stderr": ""
}
