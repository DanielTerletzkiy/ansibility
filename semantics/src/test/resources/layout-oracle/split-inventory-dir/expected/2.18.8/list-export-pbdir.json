{
  "ansible_core": "2.18.8",
  "tool": "ansible-inventory",
  "args": [
    "--list",
    "--export",
    "--playbook-dir",
    "{project}"
  ],
  "cfg": "project/ansible.cfg",
  "cwd": "cwd",
  "env": {},
  "rc": 0,
  "stdout": {
    "_meta": {
      "hostvars": {
        "web1": {
          "l7_vs_l9": "inventory/host_vars/web1.yml (L9)",
          "l9_vs_l10": "host_vars/web1.yml (L10)"
        }
      }
    },
    "all": {
      "children": [
        "ungrouped",
        "web"
      ],
      "vars": {
        "l4_vs_l5": "group_vars/all.yml (L5)",
        "l5_vs_l6": "group_vars/all.yml (L5)",
        "only_inventory_all": "L4"
      }
    },
    "web": {
      "hosts": [
        "web1"
      ],
      "vars": {
        "l5_vs_l6": "inventory/group_vars/web.yml (L6)",
        "l7_vs_l9": "group_vars/web.yml (L7)",
        "only_playbook_web": "L7"
      }
    }
  },
  "stderr": ""
}
