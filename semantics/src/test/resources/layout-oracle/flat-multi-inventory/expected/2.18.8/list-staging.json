{
  "ansible_core": "2.18.8",
  "tool": "ansible-inventory",
  "args": [
    "-i",
    "{project}/staging.ini",
    "--list",
    "--playbook-dir",
    "{project}"
  ],
  "cfg": null,
  "cwd": "cwd",
  "env": {},
  "rc": 0,
  "stdout": {
    "_meta": {
      "hostvars": {
        "stage-web1": {
          "v_all": "group_vars/all.yml",
          "v_web": "group_vars/web.yml"
        }
      }
    },
    "all": {
      "children": [
        "ungrouped",
        "web"
      ]
    },
    "web": {
      "hosts": [
        "stage-web1"
      ]
    }
  },
  "stderr": ""
}
