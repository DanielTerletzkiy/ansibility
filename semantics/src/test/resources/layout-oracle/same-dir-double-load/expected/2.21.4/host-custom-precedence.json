{
  "ansible_core": "2.21.4",
  "tool": "ansible-inventory",
  "args": [
    "-i",
    "{project}/hosts.ini",
    "--host",
    "web1",
    "--playbook-dir",
    "{project}"
  ],
  "cfg": null,
  "cwd": "cwd",
  "env": {
    "ANSIBLE_PRECEDENCE": "all_inventory,groups_inventory,all_plugins_inventory,groups_plugins_inventory,groups_plugins_play,all_plugins_play"
  },
  "rc": 0,
  "stdout": {
    "d": {
      "from_all": 1,
      "shared": "all"
    },
    "l": [
      "all"
    ],
    "s": "all"
  },
  "stderr": ""
}
