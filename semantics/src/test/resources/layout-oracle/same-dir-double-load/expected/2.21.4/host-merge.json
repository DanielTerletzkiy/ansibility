{
  "ansible_core": "2.21.4",
  "tool": "ansible-inventory",
  "args": [
    "-i",
    "{project}/hosts.ini",
    "--host",
    "web1",
    "--playbook-dir",
    "{project}"
  ],
  "cfg": null,
  "cwd": "cwd",
  "env": {
    "ANSIBLE_HASH_BEHAVIOUR": "merge"
  },
  "rc": 0,
  "stdout": {
    "d": {
      "from_all": 1,
      "from_web": 1,
      "shared": "web"
    },
    "l": [
      "web"
    ],
    "s": "web"
  },
  "stderr": ""
}
