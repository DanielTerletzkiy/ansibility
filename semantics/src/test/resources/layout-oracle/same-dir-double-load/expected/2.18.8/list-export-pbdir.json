{
  "ansible_core": "2.18.8",
  "tool": "ansible-inventory",
  "args": [
    "-i",
    "{project}/hosts.ini",
    "--list",
    "--export",
    "--playbook-dir",
    "{project}"
  ],
  "cfg": null,
  "cwd": "cwd",
  "env": {},
  "rc": 0,
  "stdout": {
    "_meta": {
      "hostvars": {}
    },
    "all": {
      "children": [
        "ungrouped",
        "web"
      ],
      "vars": {
        "d": {
          "from_all": 1,
          "shared": "all"
        },
        "l": [
          "all"
        ],
        "s": "all"
      }
    },
    "web": {
      "hosts": [
        "web1"
      ],
      "vars": {
        "d": {
          "from_web": 1,
          "shared": "web"
        },
        "l": [
          "web"
        ],
        "s": "web"
      }
    }
  },
  "stderr": ""
}
