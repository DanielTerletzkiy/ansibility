{
  "ansible_core": "2.21.4",
  "tool": "ansible-inventory",
  "args": [
    "--list",
    "--export"
  ],
  "cfg": "project/reversed.cfg",
  "cwd": "cwd",
  "env": {},
  "rc": 0,
  "stdout": {
    "_meta": {
      "hostvars": {
        "web1": {
          "only_a": 1,
          "only_b": 1,
          "x": "from-a"
        }
      },
      "profile": "inventory_legacy"
    },
    "all": {
      "children": [
        "ungrouped",
        "web"
      ],
      "vars": {
        "adj": "a/group_vars/all.yml",
        "adj_a": 1,
        "adj_b": 1
      }
    },
    "db": {
      "hosts": [
        "db1"
      ]
    },
    "web": {
      "children": [
        "db"
      ],
      "hosts": [
        "web1",
        "web2",
        "shared1"
      ],
      "vars": {
        "g": "from-a-web-vars",
        "gv_web_b": "b/group_vars/web.yml"
      }
    }
  },
  "stderr": ""
}
