{
  "ansible_core": "2.21.4",
  "tool": "ansible-inventory",
  "args": [
    "-i",
    "{project}/accepted/all-section.ini",
    "--list",
    "--export"
  ],
  "cfg": null,
  "cwd": "cwd",
  "env": {},
  "rc": 0,
  "stdout": {
    "_meta": {
      "hostvars": {},
      "profile": "inventory_legacy"
    },
    "all": {
      "children": [
        "ungrouped",
        "web"
      ]
    },
    "ungrouped": {
      "hosts": [
        "explicit-ungrouped",
        "listed-under-all"
      ],
      "vars": {
        "u": 1
      }
    },
    "web": {
      "hosts": [
        "h1"
      ]
    }
  },
  "stderr": ""
}
