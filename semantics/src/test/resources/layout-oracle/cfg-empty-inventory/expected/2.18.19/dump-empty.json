{
  "ansible_core": "2.18.19",
  "tool": "ansible-config",
  "args": [
    "dump",
    "--only-changed",
    "--format",
    "json"
  ],
  "cfg": "project/ansible.cfg",
  "cwd": "cwd",
  "env": {},
  "rc": 0,
  "stdout": [
    {
      "name": "ANSIBLE_FORCE_COLOR",
      "origin": "env: ANSIBLE_FORCE_COLOR",
      "value": false
    },
    {
      "name": "ANSIBLE_NOCOLOR",
      "origin": "env: ANSIBLE_NOCOLOR",
      "value": true
    },
    {
      "name": "CONFIG_FILE",
      "origin": "",
      "value": "{project}/ansible.cfg"
    },
    {
      "name": "DEFAULT_HOST_LIST",
      "origin": "{project}/ansible.cfg",
      "value": [
        "{project}"
      ]
    },
    {
      "GALAXY_SERVERS": {}
    }
  ],
  "stderr": ""
}
