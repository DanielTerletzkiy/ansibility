{
  "ansible_core": "2.18.8",
  "tool": "ansible-config",
  "args": [
    "dump",
    "--format",
    "json"
  ],
  "cfg": "project/cfg/coll-both-singular-first.cfg",
  "cwd": "cwd",
  "env": {},
  "rc": 0,
  "settings": {
    "COLLECTIONS_PATHS": {
      "value": [
        "{project}/cfg/singular"
      ],
      "origin": "{project}/cfg/coll-both-singular-first.cfg"
    },
    "DEFAULT_FORKS": {
      "value": 5,
      "origin": "default"
    },
    "DEFAULT_HOST_LIST": {
      "value": [
        "/etc/ansible/hosts"
      ],
      "origin": "default"
    },
    "DEFAULT_ROLES_PATH": {
      "value": [
        "{home}/.ansible/roles",
        "/usr/share/ansible/roles",
        "/etc/ansible/roles"
      ],
      "origin": "default"
    },
    "DEFAULT_TIMEOUT": {
      "value": 10,
      "origin": "default"
    },
    "INVENTORY_IGNORE_EXTS": {
      "value": [
        ".pyc",
        ".pyo",
        ".swp",
        ".bak",
        "~",
        ".rpm",
        ".md",
        ".txt",
        ".rst",
        ".orig",
        ".ini",
        ".cfg",
        ".retry"
      ],
      "origin": "default"
    },
    "PLAYBOOK_DIR": {
      "value": null,
      "origin": "default"
    }
  },
  "stderr": "[DEPRECATION WARNING]: [defaults]collections_paths option. Reason: does not fit\n var naming standard, use the singular form collections_path instead \nAlternatives: none. This feature will be removed in version 2.19. Deprecation \nwarnings can be disabled by setting deprecation_warnings=False in ansible.cfg."
}
